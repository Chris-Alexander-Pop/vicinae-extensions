{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "vicinae-env.d.ts"],
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "lib": ["es2024"],
    "moduleResolution": "node",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"]
  }
}
