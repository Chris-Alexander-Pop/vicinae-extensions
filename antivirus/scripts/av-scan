#!/usr/bin/env python3
"""ClamAV scan with progress, history, and resume after interrupt."""
from __future__ import annotations

import argparse
import atexit
import json
import os
import signal
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home()))).expanduser()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "clamav"
PROGRESS_PATH = STATE_DIR / "progress.json"
HISTORY_PATH = STATE_DIR / "history.json"
PID_PATH = STATE_DIR / "scan.pid"
FILELIST_PATH = STATE_DIR / "filelist.nul"
CLAMD_SOCKET = Path("/run/clamav/clamd.ctl")
NOTIFY_STAMP = STATE_DIR / "notified.json"

SKIP_DIR_NAMES = {
    "node_modules",
    ".git",
    ".cache",
    "Trash",
    ".venv",
    "venv",
    "__pycache__",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".uv-cache",
    "target",
}

SKIP_PREFIXES = [
    HOME / "Android",
    HOME / ".android",
    HOME / ".local/share/Trash",
    HOME / ".local/share/containers",
    HOME / ".cache",
    HOME / ".local/share/Steam",
    HOME / ".steam",
    HOME / ".local/share/umu",
    HOME / ".local/share/lutris",
    HOME / ".docker",
    HOME / ".ollama",
    HOME / ".gradle",
    HOME / ".cargo",
    HOME / ".rustup",
    HOME / ".npm",
    HOME / ".pub-cache",
    HOME / ".wine",
    HOME / ".local/share/flatpak",
    HOME / ".local/share/uv",
    HOME / ".m2",
]

BATCH_CLAMD = 1200
BATCH_CLAMSCAN = 250
MAX_HISTORY = 80
CHILD: subprocess.Popen[bytes] | None = None
LOG: Path | None = None
PROGRESS: dict = {}
SESSION_START = time.time()
ELAPSED_BASE = 0.0
SCAN_SESSION_START: float | None = None
SCAN_ELAPSED_BASE = 0.0
FINISHED = False
ACTIVE_FILELIST = FILELIST_PATH

def wall_elapsed() -> int:
    return int(ELAPSED_BASE + (time.time() - SESSION_START))


def scan_elapsed() -> float:
    if SCAN_SESSION_START is None:
        return SCAN_ELAPSED_BASE
    return SCAN_ELAPSED_BASE + (time.time() - SCAN_SESSION_START)


def log(msg: str) -> None:
    line = msg if msg.endswith("\n") else msg + "\n"
    sys.stdout.write(line)
    sys.stdout.flush()
    if LOG:
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(line)


def notify(title: str, body: str, urgency: str = "normal") -> None:
    try:
        subprocess.Popen(
            [
                "/usr/bin/notify-send",
                "-u",
                urgency,
                "-a",
                "Antivirus",
                title,
                body,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def mark_notified() -> None:
    key = f"{PROGRESS.get('id')}:{PROGRESS.get('state')}:{PROGRESS.get('infected', 0)}"
    try:
        NOTIFY_STAMP.write_text(json.dumps({"key": key}) + "\n", encoding="utf-8")
    except OSError:
        pass


def write_progress(**kwargs: object) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PROGRESS.update(kwargs)
    PROGRESS["updatedAt"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    PROGRESS["elapsedSec"] = wall_elapsed()
    PROGRESS["scanElapsedSec"] = int(scan_elapsed())
    tmp = PROGRESS_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(PROGRESS, indent=2) + "\n", encoding="utf-8")
    tmp.replace(PROGRESS_PATH)


def upsert_history() -> None:
    entry = {
        "id": PROGRESS.get("id"),
        "kind": PROGRESS.get("kind", "full"),
        "targets": PROGRESS.get("targets", []),
        "state": PROGRESS.get("state"),
        "phase": PROGRESS.get("phase"),
        "startedAt": PROGRESS.get("startedAt"),
        "endedAt": PROGRESS.get("endedAt"),
        "elapsedSec": PROGRESS.get("elapsedSec", 0),
        "scanElapsedSec": PROGRESS.get("scanElapsedSec", 0),
        "total": PROGRESS.get("total"),
        "done": PROGRESS.get("done", 0),
        "percent": PROGRESS.get("percent"),
        "infected": PROGRESS.get("infected", 0),
        "hits": PROGRESS.get("hits", []),
        "log": PROGRESS.get("log"),
        "filelist": PROGRESS.get("filelist"),
        "applyExcludes": PROGRESS.get("applyExcludes", True),
    }
    items: list = []
    if HISTORY_PATH.exists():
        try:
            items = json.loads(HISTORY_PATH.read_text(encoding="utf-8"))
            if not isinstance(items, list):
                items = []
        except json.JSONDecodeError:
            items = []
    rid = entry.get("id")
    items = [i for i in items if i.get("id") != rid]
    items.insert(0, entry)
    kept = items[:MAX_HISTORY]
    tmp = HISTORY_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(kept, indent=2) + "\n", encoding="utf-8")
    tmp.replace(HISTORY_PATH)
    keep_ids = {i.get("id") for i in kept if i.get("id")}
    prune_filelists(keep_ids)


def eta_sec(done: int, total: int) -> int | None:
    elapsed = scan_elapsed()
    if done < 40 or elapsed < 20 or total <= 0 or done <= 0:
        return None
    rate = done / elapsed
    if rate <= 0:
        return None
    return max(0, int((total - done) / rate))


def skip_dir(path: Path) -> bool:
    if path.name in SKIP_DIR_NAMES:
        return True
    s = str(path)
    for prefix in SKIP_PREFIXES:
        p = str(prefix)
        if s == p or s.startswith(p + os.sep):
            return True
    return False


def clamd_ready() -> bool:
    if not CLAMD_SOCKET.is_socket():
        return False
    try:
        subprocess.run(
            ["/usr/bin/systemctl", "is-active", "--quiet", "clamav-daemon"],
            check=True,
            timeout=3,
        )
        return True
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return False


def quick_targets() -> list[Path]:
    cands = [HOME / "Downloads", HOME / "Desktop", Path("/tmp"), HOME / "tmp"]
    return [p for p in cands if p.exists()]


def filelist_for(run_id: str) -> Path:
    return STATE_DIR / f"filelist-{run_id}.nul"


def prune_filelists(keep_ids: set) -> None:
    for p in STATE_DIR.glob("filelist-*.nul"):
        rid = p.name[len("filelist-") : -len(".nul")]
        if rid not in keep_ids:
            try:
                p.unlink()
            except OSError:
                pass


def point_generic_filelist(dest: Path) -> None:
    if dest == FILELIST_PATH:
        return
    try:
        if FILELIST_PATH.exists() or FILELIST_PATH.is_symlink():
            FILELIST_PATH.unlink()
        FILELIST_PATH.symlink_to(dest)
    except OSError:
        pass


def count_and_list(targets: list[Path], apply_excludes: bool, dest: Path) -> int:
    total = 0
    dest.parent.mkdir(parents=True, exist_ok=True)
    with dest.open("wb") as out:
        for target in targets:
            if not target.exists():
                log(f"skip missing target: {target}")
                continue
            if target.is_file():
                out.write(os.fsencode(target) + b"\0")
                total += 1
                continue
            for root, dirs, files in os.walk(target, followlinks=False):
                root_p = Path(root)
                if apply_excludes:
                    dirs[:] = [d for d in dirs if not skip_dir(root_p / d)]
                for name in files:
                    full = root_p / name
                    try:
                        st = full.lstat()
                    except OSError:
                        continue
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    out.write(os.fsencode(full) + b"\0")
                    total += 1
                    if total % 8000 == 0:
                        write_progress(
                            phase="counting",
                            state="counting",
                            total=None,
                            done=total,
                            percent=None,
                            etaSec=None,
                            current=str(full),
                            message=f"Counting files… {total:,}",
                        )
    return total


def iter_nul(path: Path, skip: int = 0):
    skipped = 0
    with path.open("rb") as fh:
        buf = b""
        while True:
            chunk = fh.read(1024 * 1024)
            if not chunk:
                break
            buf += chunk
            parts = buf.split(b"\0")
            buf = parts.pop()
            for p in parts:
                if not p:
                    continue
                if skipped < skip:
                    skipped += 1
                    continue
                yield os.fsdecode(p)
        if buf:
            if skipped < skip:
                return
            yield os.fsdecode(buf)


def parse_hit(line: str) -> dict | None:
    if not line.endswith(" FOUND") or "SCAN SUMMARY" in line:
        return None
    if line.startswith("WARNING:"):
        return None
    body = line[: -len(" FOUND")]
    if ": " not in body:
        return None
    path, signature = body.rsplit(": ", 1)
    return {"path": path, "signature": signature}


def run_batch(paths: list[str], use_clamd: bool) -> tuple[int, str]:
    global CHILD
    if not paths:
        return 0, ""
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix="av-scan-batch-",
        suffix=".txt",
        delete=False,
    ) as tmp:
        for p in paths:
            if "\n" in p:
                continue
            tmp.write(p + "\n")
        batch_path = tmp.name
    try:
        if use_clamd:
            cmd = [
                "/usr/bin/clamdscan",
                "--multiscan",
                "--fdpass",
                "--infected",
                f"--file-list={batch_path}",
            ]
        else:
            cmd = [
                "/usr/bin/clamscan",
                "--infected",
                "--bytecode-timeout=120000",
                "--max-filesize=4000M",
                "--max-scansize=4000M",
                f"--file-list={batch_path}",
            ]
        CHILD = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        out_b, _ = CHILD.communicate()
        rc = CHILD.returncode or 0
        CHILD = None
        return rc, out_b.decode("utf-8", "replace")
    finally:
        try:
            os.unlink(batch_path)
        except OSError:
            pass


def interrupt(reason: str) -> None:
    global FINISHED
    if FINISHED:
        return
    FINISHED = True
    log(f"scan interrupted ({reason})")
    if CHILD and CHILD.poll() is None:
        CHILD.terminate()
        try:
            CHILD.wait(timeout=8)
        except subprocess.TimeoutExpired:
            CHILD.kill()
    write_progress(
        state="interrupted",
        endedAt=time.strftime("%Y-%m-%dT%H:%M:%S"),
        message=f"Interrupted at {PROGRESS.get('done', 0):,} files — resume from Antivirus",
        pid=None,
    )
    upsert_history()
    mark_notified()
    notify(
        "Scan interrupted",
        PROGRESS.get("message") or "Resume from Antivirus",
        "normal",
    )
    try:
        PID_PATH.unlink(missing_ok=True)
    except OSError:
        pass


def shutdown(_signum: int, _frame: object) -> None:
    interrupt("signal")
    sys.exit(130)


def on_exit() -> None:
    if not FINISHED and PROGRESS.get("state") in {"counting", "scanning"}:
        interrupt("exit")


def load_progress() -> dict:
    if not PROGRESS_PATH.exists():
        return {}
    try:
        data = json.loads(PROGRESS_PATH.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except json.JSONDecodeError:
        return {}


def finish_ok(total: int, done: int, infected: int, worst_rc: int) -> int:
    global FINISHED
    FINISHED = True
    summary = (
        f"\n----------- SCAN SUMMARY -----------\n"
        f"Scanned files: {done}\n"
        f"Infected files: {infected}\n"
        f"Time: {wall_elapsed()}s\n"
    )
    log(summary)
    write_progress(
        state="done",
        phase="scanning",
        endedAt=time.strftime("%Y-%m-%dT%H:%M:%S"),
        total=total,
        done=done,
        percent=100,
        etaSec=0,
        infected=infected,
        current=None,
        message=f"Done · {infected} infected",
        pid=None,
    )
    upsert_history()
    mark_notified()
    latest = STATE_DIR / "latest.log"
    try:
        if latest.exists() or latest.is_symlink():
            latest.unlink()
        if LOG:
            latest.symlink_to(LOG)
    except OSError:
        pass
    PID_PATH.unlink(missing_ok=True)
    for path in {ACTIVE_FILELIST, FILELIST_PATH}:
        try:
            if path.exists() or path.is_symlink():
                path.unlink()
        except OSError:
            pass
    body = f"{done:,} files · {infected} infected · {wall_elapsed()}s"
    notify(
        "Scan finished" if infected == 0 else f"Scan finished · {infected} infected",
        body,
        "critical" if infected else "normal",
    )
    log(f"log: {LOG}")
    return 1 if worst_rc == 1 else (0 if worst_rc == 0 else worst_rc)


def scan_filelist(
    total: int, skip: int, use_clamd: bool, hits: list, filelist: Path
) -> tuple[int, int, int]:
    global SCAN_SESSION_START
    SCAN_SESSION_START = time.time()
    batch_size = BATCH_CLAMD if use_clamd else BATCH_CLAMSCAN
    done = skip
    infected = len(hits)
    worst_rc = 1 if infected else 0
    batch: list[str] = []

    def flush() -> None:
        nonlocal done, infected, worst_rc, batch
        if not batch:
            return
        current = batch[0]
        rc, text = run_batch(batch, use_clamd)
        if rc == 1:
            worst_rc = max(worst_rc, 1)
        elif rc not in (0, 1):
            worst_rc = max(worst_rc, rc)
        for line in text.splitlines():
            hit = parse_hit(line)
            if not hit:
                continue
            hits.append(hit)
            infected = len(hits)
            log(line)
        done += len(batch)
        percent = round(100.0 * done / total, 1) if total else 100.0
        write_progress(
            phase="scanning",
            state="scanning",
            total=total,
            done=done,
            percent=percent,
            etaSec=eta_sec(done, total),
            infected=infected,
            hits=hits,
            current=current,
            message=f"{done:,} / {total:,} files",
        )
        batch = []

    if total == 0:
        return 0, 0, 0

    for path in iter_nul(filelist, skip=skip):
        batch.append(path)
        if len(batch) >= batch_size:
            flush()
    flush()
    return total, done, worst_rc


def main() -> int:
    global LOG, SESSION_START, ELAPSED_BASE, SCAN_ELAPSED_BASE, PROGRESS, ACTIVE_FILELIST
    parser = argparse.ArgumentParser(description="ClamAV scan with progress and resume")
    parser.add_argument("targets", nargs="*")
    parser.add_argument("--kind", choices=["full", "quick", "path"], default=None)
    parser.add_argument("--resume", action="store_true")
    parser.add_argument("--all", action="store_true", help="do not apply black-hole excludes")
    parser.add_argument("--clamscan", action="store_true", help="force standalone clamscan")
    args = parser.parse_args()

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    SESSION_START = time.time()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGHUP, shutdown)
    atexit.register(on_exit)

    saved = load_progress()
    use_clamd = (not args.clamscan) and clamd_ready()

    if args.resume:
        if not saved:
            raise SystemExit("nothing to resume")
        if saved.get("state") == "done":
            raise SystemExit("last scan already finished")
        kind = saved.get("kind") or "full"
        targets = [Path(t) for t in saved.get("targets") or [str(HOME)]]
        apply_excludes = bool(saved.get("applyExcludes", True))
        run_id = saved.get("id") or time.strftime("%Y%m%d-%H%M%S")
        log_path = saved.get("log")
        LOG = Path(log_path) if log_path else STATE_DIR / f"scan-{run_id}.log"
        ELAPSED_BASE = float(saved.get("elapsedSec") or 0)
        SCAN_ELAPSED_BASE = float(saved.get("scanElapsedSec") or 0)
        hits = list(saved.get("hits") or [])
        PROGRESS = dict(saved)
        PROGRESS["id"] = run_id
        phase = saved.get("phase") or saved.get("state") or "counting"
        skip = int(saved.get("done") or 0) if phase == "scanning" else 0
        total = saved.get("total")
        fl = Path(saved.get("filelist") or filelist_for(run_id))
        if not fl.exists() and FILELIST_PATH.exists():
            fl = FILELIST_PATH
        filelist_ok = fl.exists() and fl.stat().st_size > 0
        resume_scan = (
            phase == "scanning" and filelist_ok and isinstance(total, int) and total >= 0
        )
        if phase == "scanning" and not resume_scan:
            log("file list missing — recounting, then scanning from the start")
            skip = 0
        log(f"=== av-scan resume {time.strftime('%Y-%m-%dT%H:%M:%S')} ===")
        log(f"id: {run_id}  kind: {kind}  skip: {skip}")
    else:
        kind = args.kind
        if kind is None:
            kind = "path" if args.targets else "full"
        if kind == "quick":
            targets = quick_targets()
        elif args.targets:
            targets = [Path(t).expanduser() for t in args.targets]
        else:
            targets = [HOME]
        apply_excludes = not args.all
        run_id = time.strftime("%Y%m%d-%H%M%S")
        LOG = STATE_DIR / f"scan-{run_id}.log"
        hits = []
        skip = 0
        total = None
        resume_scan = False
        fl = filelist_for(run_id)
        PROGRESS = {
            "id": run_id,
            "kind": kind,
            "targets": [str(t) for t in targets],
            "applyExcludes": apply_excludes,
            "hits": [],
            "startedAt": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "endedAt": None,
            "filelist": str(fl),
            "log": str(LOG),
        }

    ACTIVE_FILELIST = fl
    PID_PATH.write_text(str(os.getpid()), encoding="utf-8")
    PROGRESS["pid"] = os.getpid()
    PROGRESS["kind"] = kind
    PROGRESS["targets"] = [str(t) for t in targets]
    PROGRESS["applyExcludes"] = apply_excludes
    PROGRESS["log"] = str(LOG)
    PROGRESS["filelist"] = str(fl)
    point_generic_filelist(fl)

    log(f"=== av-scan {time.strftime('%Y-%m-%dT%H:%M:%S')} ===")
    log(f"kind: {kind}")
    log(f"targets: {' '.join(str(t) for t in targets)}")
    log(f"excludes: {int(apply_excludes)}")
    log(f"engine: {'clamdscan batched' if use_clamd else 'clamscan batched'}")
    log(f"progress: {PROGRESS_PATH}")
    log("")

    if not resume_scan:
        write_progress(
            phase="counting",
            state="counting",
            total=None,
            done=0,
            percent=None,
            etaSec=None,
            infected=len(hits),
            hits=hits,
            current=None,
            message="Counting files…",
        )
        upsert_history()
        total = count_and_list(targets, apply_excludes, fl)
        log(f"files to scan: {total:,}")
        skip = 0
        write_progress(
            phase="scanning",
            state="scanning",
            total=total,
            done=0,
            percent=0,
            etaSec=None,
            infected=len(hits),
            hits=hits,
            current=None,
            message=f"0 / {total:,} files",
        )
        upsert_history()
    else:
        log(f"resuming file list ({skip:,} / {total:,})")
        write_progress(
            phase="scanning",
            state="scanning",
            total=total,
            done=skip,
            percent=round(100.0 * skip / total, 1) if total else 0,
            message=f"Resuming {skip:,} / {total:,} files",
        )
        upsert_history()

    assert isinstance(total, int)
    total, done, worst_rc = scan_filelist(total, skip, use_clamd, hits, fl)
    return finish_ok(total, done, len(hits), worst_rc)


if __name__ == "__main__":
    sys.exit(main())
