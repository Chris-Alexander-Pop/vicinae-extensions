{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "antivirus",
  "title": "Antivirus",
  "description": "ClamAV + unofficial signatures + rkhunter (local-only)",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "chris",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.svg",
  "keywords": [
    "clamav",
    "clamscan",
    "virus",
    "malware",
    "rkhunter",
    "scan"
  ],
  "commands": [
    {
      "name": "antivirus",
      "title": "Antivirus",
      "subtitle": "System",
      "description": "Scan home with ClamAV (extra signatures), update defs, run rkhunter",
      "mode": "view",
      "keywords": [
        "clamav",
        "scan",
        "virus",
        "malware",
        "rkhunter"
      ]
    },
    {
      "name": "subtitle",
      "title": "Antivirus Status",
      "subtitle": "Idle",
      "description": "Live scan/idle subtitle in root search. Background poll.",
      "mode": "no-view",
      "interval": "30s",
      "keywords": [
        "clamav",
        "status",
        "scan"
      ]
    }
  ],
  "preferences": [],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  },
  "dependencies": {
    "@vicinae/api": "^0.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
