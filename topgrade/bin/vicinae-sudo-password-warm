#!/usr/bin/env python3
"""Warm sudo using a password, despite fingerprint-first PAM.

Reads password from stdin (one line) or VICINAE_SUDO_PASS.
Claims the fprintd device so pam_fprintd fails fast, then runs `sudo -S -v`.
"""
from __future__ import annotations

import os
import subprocess
import sys


def read_password() -> str:
    # Empty env var means "use stdin" (prompt sets VICINAE_SUDO_PASS="").
    if "VICINAE_SUDO_PASS" in os.environ and os.environ["VICINAE_SUDO_PASS"]:
        return os.environ["VICINAE_SUDO_PASS"]
    return sys.stdin.readline().rstrip("\r\n")


class FprintClaim:
    """Hold the fingerprint device so pam_fprintd cannot wait on it."""

    def __init__(self) -> None:
        self._iface = None

    def __enter__(self) -> "FprintClaim":
        try:
            import dbus  # type: ignore
        except ImportError:
            return self

        try:
            bus = dbus.SystemBus()
            mgr = bus.get_object(
                "net.reactivated.Fprint", "/net/reactivated/Fprint/Manager"
            )
            devices = list(
                dbus.Interface(mgr, "net.reactivated.Fprint.Manager").GetDevices()
            )
            if not devices:
                return self
            user = os.environ.get("USER") or os.getlogin()
            device = bus.get_object("net.reactivated.Fprint", devices[0])
            self._iface = dbus.Interface(device, "net.reactivated.Fprint.Device")
            self._iface.Claim(user)
        except Exception as err:
            print(
                f"vicinae-sudo-password-warm: could not claim fingerprint "
                f"device ({err}); continuing",
                file=sys.stderr,
            )
            self._iface = None
        return self

    def __exit__(self, *args: object) -> None:
        if self._iface is None:
            return
        try:
            self._iface.Release()
        except Exception:
            pass


def warm_sudo(password: str) -> int:
    env = {
        "HOME": os.environ.get("HOME", ""),
        "USER": os.environ.get("USER", ""),
        "LOGNAME": os.environ.get("LOGNAME") or os.environ.get("USER", ""),
        "PATH": "/usr/bin:/bin",
        "TERM": "dumb",
        "LANG": os.environ.get("LANG", "C"),
    }
    proc = subprocess.run(
        ["/usr/bin/sudo", "-S", "-v"],
        input=(password + "\n").encode(),
        env=env,
        capture_output=True,
    )
    if proc.returncode == 0:
        return 0

    err = (proc.stderr or b"").decode(errors="replace")
    low = err.lower()
    if "sorry, try again" in low or "authentication failure" in low:
        print("Incorrect password", file=sys.stderr)
    elif "faillock" in low or "temporarily locked" in low or "account locked" in low:
        print(
            "Account temporarily locked (faillock)",
            file=sys.stderr,
        )
    else:
        msg = err.strip().splitlines()[-1] if err.strip() else "sudo denied"
        print(msg, file=sys.stderr)
    return 1


def main() -> int:
    password = read_password()
    if not password:
        print("Incorrect password", file=sys.stderr)
        return 1

    with FprintClaim():
        return warm_sudo(password)


if __name__ == "__main__":
    sys.exit(main())
